generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── PRODUTO ──────────────────────────────────────────────────────────────────

model Product {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  shortDescription String
  description      String   @db.Text

  // Preços
  price            Decimal  @db.Decimal(10, 2)
  originalPrice    Decimal? @db.Decimal(10, 2)

  // Badges e UI
  badge            String?
  badgeVariant     String?

  // Avaliações (rating calculado a partir das Reviews)
  rating           Decimal  @default(0) @db.Decimal(2, 1)
  reviews          Int      @default(0)

  images           String[]
  features         String[]

  // Categorização
  collection       String
  category         String
  /// Gênero da fragrância — filtro combinável com category na PLP/header.
  gender           Gender   @default(UNISSEX)

  // Métricas de Venda
  totalSold        Int      @default(0)
  seasonalSold     Int      @default(0)

  // Estoque — dado baixa no webhook de pagamento confirmado
  stock            Int      @default(0)

  // Ciclo de vida (estado do produto)
  status              ProductStatus @default(NORMAL)
  isLimitedEdition    Boolean       @default(false)
  /// Override manual do badge "Novo". Se nulo, deriva de createdAt < 30d.
  markedAsNewUntil    DateTime?
  /// Janela da promoção. Preenchidos quando status=PROMOTION; também usados
  /// pelo cron de limpeza/auto-revert.
  promotionStartsAt   DateTime?
  promotionEndsAt     DateTime?

  // Relações
  productReviews   Review[]
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
  cartItems        CartItem[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("products")
}

enum ProductStatus {
  NORMAL        // À venda pelo preço cheio
  PROMOTION     // Em promoção (validar janela startsAt/endsAt)
  COMING_SOON   // Visível mas não comprável
  DISCONTINUED  // Fora de linha (esconder do catálogo público)
}

enum Gender {
  FEMININO
  MASCULINO
  UNISSEX
}

// ─── PEDIDO ───────────────────────────────────────────────────────────────────

model Order {
  id     String      @id @default(uuid())
  status OrderStatus @default(PENDING)

  // Cliente (suporta guest e futuramente conta registrada)
  userId           String?
  customerName     String
  customerEmail    String
  customerPhone    String
  customerCpf      String

  // Endereço de entrega — snapshot (não FK, garante histórico imutável)
  addressCep          String
  addressStreet       String
  addressNumber       String
  addressComplement   String?
  addressNeighborhood String
  addressCity         String
  addressState        String

  // Valores
  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @db.Decimal(10, 2) @default(0)
  discount     Decimal @db.Decimal(10, 2) @default(0)
  total        Decimal @db.Decimal(10, 2)

  // Pagamento — Mercado Pago
  mpPaymentId   String?
  mpStatus      String? // status interno do MP (approved, pending, rejected…)
  paymentMethod String? // "pix" | "credit_card"

  // Entrega
  trackingCode String?
  couponCode   String?

  items     OrderItem[]
  events    OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

enum OrderStatus {
  PENDING            // Aguardando pagamento
  PAYMENT_CONFIRMED  // Pagamento confirmado pelo webhook MP
  PREPARING          // Em separação
  SHIPPED            // Enviado (trackingCode preenchido)
  DELIVERED          // Entregue
  CANCELLED          // Cancelado
}

// ─── ITEM DO PEDIDO ───────────────────────────────────────────────────────────

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // FK para o produto (para consultas) + snapshot para histórico imutável
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String  // snapshot
  productSlug String  // snapshot
  category    String  // snapshot
  imageUrl    String  // snapshot — primeira imagem do produto

  price    Decimal @db.Decimal(10, 2) // preço no momento da compra
  quantity Int

  @@map("order_items")
}

// ─── EVENTOS DE PEDIDO ────────────────────────────────────────────────────────

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  createdAt DateTime    @default(now())
  metadata  Json?       // { paymentId?, mpStatus?, source: "checkout" | "webhook" | "admin", auto?: bool }

  @@index([orderId, createdAt])
  @@map("order_events")
}

// ─── AVALIAÇÃO ────────────────────────────────────────────────────────────────

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Autor (guest ou registrado — userId null para guest)
  userId      String?
  authorName  String
  authorEmail String

  rating   Int     // 1 a 5
  text     String? @db.VarChar(250)
  approved Boolean @default(true) // auto-aprovação definida em 14/04/2026

  createdAt DateTime @default(now())

  @@map("reviews")
}

// ─── CUPOM ────────────────────────────────────────────────────────────────────

model Coupon {
  id        String     @id @default(uuid())
  code      String     @unique
  type      CouponType
  value     Decimal    @db.Decimal(10, 2) // % ou R$ dependendo do type
  minOrder  Decimal?   @db.Decimal(10, 2) // pedido mínimo para aplicar
  maxUses   Int?                           // null = ilimitado
  usedCount Int        @default(0)
  expiresAt DateTime?
  active    Boolean    @default(true)

  createdAt DateTime @default(now())

  @@map("coupons")
}

enum CouponType {
  PERCENTAGE // ex: 10 = 10% de desconto
  FIXED      // ex: 20 = R$20 de desconto
}

// ─── NEWSLETTER ───────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ─── CONTATO ──────────────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// ─── AUTENTICAÇÃO (Auth.js v5 / NextAuth) ─────────────────────────────────────
// Modelos do @auth/prisma-adapter. Nomes de campos OAuth em snake_case são
// exigência do adapter — não renomear.

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Hash bcrypt da senha. Null em contas criadas só via OAuth (Google).
  passwordHash  String?

  accounts      Account[]
  sessions      Session[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── CARRINHO E FAVORITOS POR USUÁRIO ─────────────────────────────────────────
// Dados privados por usuário — substituem o armazenamento global em localStorage.

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

// ─── LOCKOUT DE LOGIN DO ADMIN ────────────────────────────────────────────────
// Rate limit por chave (IP) para o login admin via senha+TOTP. Recuperável
// pelo suporte: auto-expira (lockedUntil) e pode ser zerado por script.

model AdminLoginAttempt {
  id          String    @id @default(uuid())
  /// Chave do contador — normalmente o IP da requisição.
  key         String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("admin_login_attempts")
}

/// Contador de rate limit compartilhado entre instâncias.
///
/// Existe porque o store em memória não funciona em serverless: cada
/// instância tem o seu `Map`, e quem ataca com concorrência cai em
/// instâncias diferentes e passa por baixo do limite. O Postgres é a
/// memória que todas compartilham — mesma escolha que `AdminLoginAttempt`
/// já fazia para o login admin.
///
/// Janela fixa, não deslizante: `windowStart` marca o início da janela
/// corrente e `count` é quanto já entrou nela. O erro de borda (até 2x o
/// limite na virada) é aceitável para o que se barra aqui, e em troca o
/// registro é uma linha por chave, atualizada por um único `INSERT ... ON
/// CONFLICT` — atômico sob concorrência, sem transação explícita.
model RateLimitWindow {
  /// `<regra>:<cliente>` — ex.: `couponValidate:203.0.113.7`.
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime

  /// Serve só à limpeza das janelas vencidas.
  @@index([windowStart])
  @@map("rate_limit_windows")
}
