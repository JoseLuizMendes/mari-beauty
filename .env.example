# ─────────────────────────────────────────────────────────────────────────────
# Belessence (Mari Beauty) — variáveis de ambiente (EXEMPLO)
# ─────────────────────────────────────────────────────────────────────────────
# Como usar:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores reais (NUNCA comite o .env — só este .env.example).
#
# Onde cada valor vive em cada ambiente:
#   • dev      → este .env local (banco = Docker; credenciais externas = sandbox)
#   • preview  → Vercel, escopo "Preview"  (banco = branch Neon "preview")
#   • prod     → Vercel, escopo "Production" (banco = Neon primário; creds LIVE)
#   • CI       → GitHub Actions Secrets (valores dummy/de teste)
#
# VALIDAÇÃO: o ambiente é checado com Zod no boot do servidor
# (src/lib/shared/infrastructure/env.ts, chamado por instrumentation.ts).
#   • NÚCLEO (DATABASE_URL, ADMIN_SECRET, AUTH_SECRET) → faltou, não sobe.
#   • DEMAIS → agrupadas por feature. Incompletas, a feature é desligada e o
#     boot avisa no console quais e por quê. A app sobe normalmente.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ───────────────────────────────────────────────────────────
# DEV: aponta para o Postgres do docker-compose (db "belessence_dev", porta 5544).
# PREVIEW/PROD: use a connection string do Neon (com sslmode=require & pooling).
DATABASE_URL="postgresql://belessence:belessence@localhost:5544/belessence_dev?schema=public"

# ── Rodar contra PRODUÇÃO (caso específico) ──────────────────────────────────
# O DATABASE_URL acima aponta pro Docker (dev) — esse é o padrão e o seguro.
# Para rodar PONTUALMENTE contra o banco real de prod (Neon), use o .env.prod
# (arquivo local, gitignored). Procedimento:
#
#   QUANDO  → reproduzir um bug que só ocorre com dado real; inspecionar/depurar
#             dados de produção. NUNCA para desenvolvimento normal.
#   ONDE    → a fonte da verdade das credenciais de prod é a Vercel. Localmente
#             elas ficam no .env.prod. Para (re)gerar a partir da Vercel:
#               vercel env pull .env.prod --environment=production
#   COMO    → no PowerShell, SÓ na janela de terminal atual (override temporário):
#               $env:DATABASE_URL = (Select-String .env.prod -Pattern '^DATABASE_URL=' |
#                 Select-Object -First 1).Line -replace '^DATABASE_URL=','' -replace '^"|"$',''
#               $env:DATABASE_URL          # confira: deve ser a URL do Neon
#               pnpm prisma studio         # inspecionar (ideal) — ou: pnpm dev
#             Ao terminar, FECHE o terminal (descarta o override → volta pro Docker).
#             Só quer OLHAR dados? Prefira colar a URL no pgweb/DBeaver (read-only).
#   POR QUÊ  → é PRODUÇÃO: lê e ESCREVE dados reais. NUNCA rode contra prod:
#             prisma migrate reset | prisma db push --force-reset | prisma db seed

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Gere um segredo com:  npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="changeme-gere-um-segredo-aleatorio"
# Em dev/local mantenha "true". A Vercel define o host automaticamente em prod.
AUTH_TRUST_HOST="true"

# ── Admin (login + 2FA) ──────────────────────────────────────────────────────
# Chave de ASSINATURA (HS256) do cookie `admin_session` que protege /admin/*.
# NÃO é o valor do cookie: o cookie é um JWT assinado com esta chave, com exp
# real e TOKEN_VERSION para revogação em massa (src/lib/auth/presentation/
# admin-auth.ts). Mínimo de 16 caracteres — validado no boot.
ADMIN_SECRET="changeme-segredo-do-admin"
# Senha em texto puro usada APENAS pelos scripts de setup (scripts/admin-*.mjs)
# para gerar o hash abaixo. Não é lida pelo app em runtime.
ADMIN_PASSWORD="changeme-senha-do-admin"
# Hash bcrypt da senha admin (gere com: node scripts/admin-set-password.mjs).
ADMIN_PASSWORD_HASH="$2a$..."
# Segredo TOTP do 2FA do admin (gere com: node scripts/admin-setup.mjs).
ADMIN_TOTP_SECRET="changeme-base32-totp"
# E-mails autorizados a logar como admin via Google (separados por vírgula).
ADMIN_ALLOWLIST_EMAILS="voce@exemplo.com"

# ── OAuth Google (login admin) ───────────────────────────────────────────────
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="changeme-google-oauth-secret"

# ── Cloudinary (imagens de produto) ──────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="seu-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="000000000000000"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER="belessence/dev"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="changeme-cloudinary-secret"

# ── SEO / URL canônica ───────────────────────────────────────────────────────
# Origem absoluta do site. Usada por sitemap.xml, robots.txt, metadataBase e
# pelos dados estruturados (JSON-LD) — todos precisam concordar, senão o
# Google vê a mesma loja em endereços diferentes.
# Se não definir, a cadeia cai em VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL →
# http://localhost:3000. Defina quando houver domínio próprio.
# NEXT_PUBLIC_SITE_URL="https://maribeauty.com.br"

# ── Mercado Pago (pagamentos) ────────────────────────────────────────────────
# Lido em src/lib/payment/.../payment-provider.ts.
# dev/preview: use o Access Token de TESTE (sandbox). prod: token LIVE.
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxx-000000000"

# ── Resend (e-mail transacional) ─────────────────────────────────────────────
# AINDA NÃO referenciado no código. Descomente e configure quando o envio de
# e-mail (React Email) for implementado.
# RESEND_API_KEY="re_xxxxxxxx"

# ── Sentry (captura de erro em produção) ─────────────────────────────────────
# Sem DSN o SDK não inicializa e nada é enviado — dá para rodar local sem conta.
# O DSN é público por desenho (vai no bundle do cliente); o que não pode vazar é
# o AUTH_TOKEN, usado só no build para subir os source maps.
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oYYY.ingest.sentry.io/ZZZ"
# SENTRY_DSN="https://xxxx@oYYY.ingest.sentry.io/ZZZ"
# SENTRY_ORG="sua-org"
# SENTRY_PROJECT="belessence"
# SENTRY_AUTH_TOKEN="sntrys_..."

# ── Testes E2E (Playwright) — opcional ───────────────────────────────────────
# Padrões já assumidos pelo playwright.config.ts; só sobrescreva se precisar.
# E2E_BASE_URL="http://localhost:3000"
# E2E_PORT="3000"
